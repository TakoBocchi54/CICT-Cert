PORT=
DATABASE_URL=
FRONTEND_URL=

# Web3Auth configuration
WEB3AUTH_CLIENT_ID=
WEB3AUTH_JWKS_URL=
WEB3AUTH_ISSUER=

# Session secret
SESSION_SECRET=


# Blockchain Network
AMOY_RPC_URL=
CONTRACT_ADDRESS=
# Backend only. Use the same Amoy issuer wallet that deployed the contract.
ISSUER_PRIVATE_KEY=
# Optional. Certificates minted per issuing transaction, 1-200 (default 100, about 7.5M gas).
ISSUE_BATCH_SIZE=
# Optional. Warn issuers when the issuer wallet drops below this many POL (default 0.5, about two full batches).
ISSUER_LOW_BALANCE_POL=
